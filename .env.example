# Flask
SECRET_KEY=change-this-secret
APP_CREDENTIALS_KEY=

# MySQL / MariaDB
DB_USER=webui
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webui_manager

# Docker
APP_PORT=5000

# Optional - overrides all DB_* fields
# DATABASE_URL=mysql+pymysql://webui:password@127.0.0.1:3306/webui_manager?charset=utf8mb4

# Optional
# AUTO_MIGRATE=true

# Optional - seconds before a pooled DB connection is recycled.
# Must stay below your MySQL wait_timeout. Lower it if connections still drop
# behind an aggressive proxy/load balancer.
# DB_POOL_RECYCLE=280
