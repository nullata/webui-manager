# Flask
SECRET_KEY=change-this-secret
APP_CREDENTIALS_KEY=

# Optional - name of the session cookie. Only change this if you run several
# copies of WebUI Manager on the same hostname and want each to keep its own
# login. The default is already unique enough not to clash with other apps.
# SESSION_COOKIE_NAME=webui_manager_session

# Database backend: mysql (default) or sqlite
# DB_TYPE=sqlite

# MySQL / MariaDB (when DB_TYPE=mysql)
DB_USER=webui
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webui_manager

# SQLite (when DB_TYPE=sqlite)
# DB_PATH=data/webui_manager.sqlite

# Docker
APP_PORT=5000

# Optional - overrides all DB_* fields and DB_TYPE
# DATABASE_URL=mysql+pymysql://webui:password@127.0.0.1:3306/webui_manager?charset=utf8mb4
# DATABASE_URL=sqlite:///absolute/path/to/webui_manager.sqlite

# Optional
# AUTO_MIGRATE=true

# Optional - seconds before a pooled DB connection is recycled (MySQL only).
# Must stay below your MySQL wait_timeout. Lower it if connections still drop
# behind an aggressive proxy/load balancer.
# DB_POOL_RECYCLE=280
